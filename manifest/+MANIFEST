name: os-ipsec-watchdog
version: "1.1"
origin: "net/os-ipsec-watchdog"
comment: "IPsec tunnel watchdog with GUI"
desc: "Monitors one or more configured IPsec (swanctl) connections and force-reconnects any that stay down beyond their configured threshold. Includes a VPN > IPsec Watchdog settings page with a live tunnel status table."
maintainer: "me@nerexbcd.dev"
www: "https://github.com/Nerexbcd/OPNSense-IPSec-WatchDog"
prefix: /usr/local
categories: [net]
licenselogic: single
licenses: [BSD2CLAUSE]
deps: {}
scripts: {
    post-install: <<EOD
#!/bin/sh
chmod +x /usr/local/opnsense/scripts/OPNsense/IPsecWatchdog/watchdog.php
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml
service configd restart >/dev/null 2>&1 || /usr/local/etc/rc.d/configd restart >/dev/null 2>&1
/usr/local/sbin/configctl webgui restart >/dev/null 2>&1 || service lighttpd restart >/dev/null 2>&1 || /usr/local/etc/rc.d/lighttpd restart >/dev/null 2>&1
EOD
    pre-deinstall: <<EOD
#!/bin/sh
logger -t ipsec-watchdog "Uninstalling os-ipsec-watchdog"
EOD
}
